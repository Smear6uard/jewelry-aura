# Shopify headless storefront — server-only credentials.
# Never expose these to the browser; only server modules read them.
# In Vercel, scope SHOPIFY_STOREFRONT_PRIVATE_TOKEN and SHOPIFY_WEBHOOK_SECRET
# to the Production environment only. Rotation steps: docs/RUNBOOK.md.

# Store domain, e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Private access token from the Headless channel (Storefront API, server lane)
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# API secret of the one-time custom app used for webhook HMAC verification.
# Unused until the webhook receiver ships (U9).
SHOPIFY_WEBHOOK_SECRET=

# LOCAL DEV ONLY — point the client at Shopify's public mock Storefront API
# to build/review without credentials. NEVER set this in Vercel.
# SHOPIFY_API_ENDPOINT=https://mock.shop/api
